# ---------------------------------------------------------------------------
# 第三方资源（体积大，且都有各自的许可证，不入库）
# 获取方式见 README「依赖与准备」
# ---------------------------------------------------------------------------

# AI 引擎与权重（Pikafish，GPL-3.0，约 55MB）
engines/
*.nnue

# 识别模型（ONNX 权重，约 40MB）
# 权重放在 xq_research/hf_model/ 下，按 README 说明下载
#
# ★ 这条必须带前导 /，只锚定**仓库根目录**的 xq_research/（资源目录）。
#   若写成不带 / 的 `xq_research/`，它会匹配任意层级下的同名目录，
#   把 vendor/xq_research/ 一起忽略掉 —— 而那里放的是**必须入库的代码**
#   （xq_vision.py / engine_client.py）。模型权重仍由下面的 *.onnx 兜底。
/xq_research/
hf_model/
*.onnx

# 预处理过的模板库（可从截图重新生成，见 tools/build_templates.py）
data/templates/

# 开局库（本地收集的 obk/xqb 库文件，体积大且来源各异，不入库）
# ★ 带前导 / 只锚定仓库根目录的「开局库/」，避免误伤别处的同名目录。
/开局库/

# ---------------------------------------------------------------------------
# 运行产物
# ---------------------------------------------------------------------------
analysis/
shots/
probe_out/
*.png
*.jpg
*.jpeg
_launch_log.txt

# 开局库评测的中间产物（tools/book_bench/out/，最大一份 4.9MB，可由脚本重跑生成）
/tools/book_bench/out/

# 但 docs 下的截图要入库（README 引用）
!docs/
!docs/**

# ---------------------------------------------------------------------------
# 打包产物（exe 通过 GitHub Release 分发，不入库）
# ---------------------------------------------------------------------------
build/
dist/
# 打包前把上一版 dist 改名成 dist.old 以绕过 safe-delete（见 MEMORY.md），
# 不忽略的话 `git add -A` 会把几百 MB 的旧构建吃进仓库
dist.old/
*.spec
selftest.log

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
*.bak
*.log
*.tmp

# 打包产物备份
_build_ok/

# 工作区本地数据（AI 记忆 / 运行日志，不入库）
.workbuddy-ai/

# automove local config (per-user auto-move settings, not committed)
automove.json
